{
  "name": "graphe-bible",
  "productName": "Graphe",
  "version": "1.0.3",
  "description": "A modern Bible study app with split panes and Strong's numbers",
  "author": "Claudio Scheer",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:css && electron-forge start",
    "dev": "npm run build:css && sh -c 'npm run watch:css & CSS_PID=$!; electron-forge start; kill $CSS_PID 2>/dev/null || true'",
    "build:css": "tailwindcss -i src/renderer/styles.css -o src/renderer/dist.css",
    "watch:css": "tailwindcss -i src/renderer/styles.css -o src/renderer/dist.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "package": "electron-forge package",
    "package:linux": "electron-forge package --platform=linux --arch=x64",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "package:mac": "electron-forge package --platform=darwin --arch=universal",
    "package:desktop": "npm run package:linux && npm run package:win && npm run package:mac",
    "make": "electron-forge make",
    "make:linux": "electron-forge make --platform=linux --arch=x64",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:mac": "electron-forge make --platform=darwin --arch=universal",
    "make:desktop": "npm run make:linux && npm run make:win && npm run make:mac"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-wix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@reforged/maker-appimage": "^5.2.0",
    "@tailwindcss/cli": "^4",
    "electron": "^33.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "lucide": "^0.575.0"
  }
}
