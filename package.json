{
  "name": "graphe-bible",
  "productName": "Graphe",
  "version": "1.0.9",
  "description": "A modern Bible study app with split panes and Strong's numbers",
  "author": "Claudio Scheer",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:css && electron-forge start",
    "dev": "npm run build:css && concurrently --kill-others \"npm run watch:css\" \"electron-forge start\"",
    "build:css": "tailwindcss -i src/renderer/styles.css -o src/renderer/dist.css",
    "build:renderer": "npm run build:css && vite build --config vite.renderer.config.mjs",
    "size:renderer": "npm run build:renderer && node scripts/report-renderer-size.js",
    "size:package": "node scripts/report-package-size.js",
    "watch:css": "tailwindcss -i src/renderer/styles.css -o src/renderer/dist.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "package": "npm run build:renderer && electron-forge package",
    "package:linux": "npm run build:renderer && electron-forge package --platform=linux --arch=x64",
    "package:linux:debug": "npm run package:linux && GRAPHE_DEBUG_PACKAGED=1 ./out/Graphe-linux-x64/graphe-bible --enable-logging=stderr --trace-warnings",
    "package:win": "npm run build:renderer && electron-forge package --platform=win32 --arch=x64",
    "package:mac": "npm run build:renderer && electron-forge package --platform=darwin --arch=universal",
    "package:desktop": "npm run package:linux && npm run package:win && npm run package:mac",
    "make": "npm run build:renderer && electron-forge make",
    "make:linux": "npm run build:renderer && electron-forge make --platform=linux --arch=x64",
    "make:win": "npm run build:renderer && electron-forge make --platform=win32 --arch=x64",
    "make:mac": "npm run build:renderer && electron-forge make --platform=darwin --arch=universal",
    "make:desktop": "npm run make:linux && npm run make:win && npm run make:mac",
    "release:local": "node scripts/build-release.js",
    "test": "npm rebuild better-sqlite3 && (vitest run; status=$?; electron-rebuild -f -w better-sqlite3; exit $status)",
    "convert:theword": "node scripts/batch-convert.js",
    "compare:theword": "node scripts/compare-modules.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-wix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@reforged/maker-appimage": "^5.2.0",
    "@tailwindcss/cli": "^4",
    "concurrently": "^9.2.1",
    "electron": "^33.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "lucide": "^0.575.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "vite": "^7.3.1",
    "vitest": "^3"
  },
  "dependencies": {
    "@iarna/rtf-to-html": "^1.1.0",
    "better-sqlite3": "^11.0.0"
  }
}
