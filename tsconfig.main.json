{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "isolatedModules": false,
    "types": ["node", "electron"]
  },
  "include": ["src/main/**/*.ts", "src/preload.ts", "types/**/*.d.ts"]
}
